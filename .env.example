# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Get a key at https://console.anthropic.com/settings/keys
# (Or leave it unset and run `ant auth login`; the SDK picks that profile up automatically.)
ANTHROPIC_API_KEY=

